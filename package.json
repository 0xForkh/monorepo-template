{
  "name": "monorepo-template",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "dev": "pm2 start ecosystem.config.cjs --only dev-backend,dev-frontend && pm2 logs",
    "start": "npm run build && pm2 start ecosystem.config.cjs --only prod-backend && pm2 logs",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "npm run typecheck --prefix backend",
    "typecheck:frontend": "npm run typecheck --prefix frontend",
    "db:migrate": "dotenv -e .env -- npm run db:migrate --prefix backend --",
    "db:migrate:deploy": "dotenv -e .env -- npm run db:migrate:deploy --prefix backend",
    "db:push": "dotenv -e .env -- npm run db:push --prefix backend",
    "db:generate": "dotenv -e .env -- npm run db:generate --prefix backend",
    "db:studio": "dotenv -e .env -- npm run db:studio --prefix backend",
    "db:reset": "dotenv -e .env -- npm run db:reset --prefix backend",
    "build": "npm run build --prefix frontend",
    "stop": "pm2 stop ecosystem.config.cjs",
    "delete": "pm2 delete ecosystem.config.cjs",
    "logs": "pm2 logs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
