DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional: extra origins allowed to call the API with credentials (comma-separated)
# CORS_ORIGINS=

# Optional: Sentry/GlitchTip error tracking
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# Optional: Vibehub devtools overlay (dev only; omit to disable)
# VITE_VIBEHUB_URL=
# VITE_PROJECT_SLUG=
