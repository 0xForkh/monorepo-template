{
  "name": "monorepo-template",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "install:all": "pnpm install",
    "dev": "vhdev up",
    "typecheck": "pnpm run typecheck:backend && pnpm run typecheck:frontend",
    "typecheck:backend": "pnpm --filter backend run typecheck",
    "typecheck:frontend": "pnpm --filter frontend run typecheck",
    "db:migrate": "dotenv -e .env -- pnpm --filter backend run db:migrate --",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter backend run db:migrate:deploy",
    "db:push": "dotenv -e .env -- pnpm --filter backend run db:push",
    "db:generate": "dotenv -e .env -- pnpm --filter backend run db:generate",
    "db:studio": "dotenv -e .env -- pnpm --filter backend run db:studio",
    "db:reset": "dotenv -e .env -- pnpm --filter backend run db:reset",
    "build": "pnpm --filter frontend run build",
    "stop": "vhdev stop",
    "down": "vhdev down",
    "logs": "vhdev logs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/engines", "esbuild", "prisma"]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
